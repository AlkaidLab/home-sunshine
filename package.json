{
  "name": "home-sunshine",
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "docs:dev": "vitepress dev docs",
    "build": "npm run build:client && npm run build:ssr && npm run prerender && npm run build:docs",
    "build:client": "vite build",
    "build:ssr": "vite build --ssr src/entry-server.js --outDir dist-ssr",
    "prerender": "node scripts/prerender.mjs",
    "build:docs": "vitepress build docs",
    "test": "node --test tests/downloads.test.mjs tests/docs.test.mjs",
    "test:docs": "node --test tests/docs.test.mjs",
    "preview": "vite preview"
  },
  "dependencies": {
    "@vue/runtime-vapor": "3.6.0-rc.11",
    "@vue/server-renderer": "3.6.0-rc.11",
    "vue": "3.6.0-rc.11"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.10",
    "less": "^4.2.1",
    "vite": "^8.3.4",
    "vitepress": "1.6.4",
    "vitepress-theme-teek": "1.6.2"
  },
  "overrides": {
    "vue": "$vue",
    "@vue/shared": "$vue"
  }
}
